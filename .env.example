# Copy this file to .env and insert your own Google AI Studio API key.
GOOGLE_API_KEY=replace_me

# Current stable Gemini Flash model. Change this if your account uses another model.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local development values. Set a new unpredictable SECRET_KEY and DEBUG=False in production.
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
